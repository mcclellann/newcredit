{
  "name": "newcredit",
  "private": true,
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @newcredit/api --filter @newcredit/web dev",
    "db:migrate": "pnpm --filter @newcredit/api db:migrate",
    "openapi:generate": "pnpm --filter @newcredit/api openapi:generate",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
