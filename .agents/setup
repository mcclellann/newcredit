#!/usr/bin/env bash
set -euo pipefail

started_at=$SECONDS
python3 -m pip install --quiet --disable-pip-version-check -r requirements-docs.txt
pnpm install --frozen-lockfile
printf '[orb setup] Installed application and synthetic-document tooling.\n'
printf '[orb setup] Completed in %ss.\n' "$((SECONDS - started_at))"
