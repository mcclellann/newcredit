{
  "name": "@newcredit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm db:migrate && tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/swagger": "^9.5.1",
    "@newcredit/domain": "workspace:*",
    "@newcredit/test-fixtures": "workspace:*",
    "@sinclair/typebox": "^0.34.41",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.1",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^5.7.284"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
